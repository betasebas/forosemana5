<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F0F4C3"> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="🐾 Mi Tienda de Mascotas 🐾"
    android:textSize="26sp"
    android:textStyle="bold"
    android:textColor="#33691E"
    android:layout_marginBottom="40dp"
    android:textAlignment="center"/>

    <Button
        android:id="@+id/btnIrCatalogo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🛍️ Catálogo de Productos"
        android:textSize="16sp"
        android:backgroundTint="#558B2F"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrGaleria"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📸 Galería de Mascotas"
        android:textSize="16sp"
        android:backgroundTint="#689F38"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnIrAudios"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🎵 Guías de Cuidado"
        android:textSize="16sp"
        android:backgroundTint="#7CB342"/>

</LinearLayout>